<Page x:Class="InvoiceApp.ListPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Language="ru-RU">
    <DockPanel Margin="22">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Накладные" FontSize="24"/>
            <WrapPanel Margin="0,12">
                <Button Content="Новая накладная" Padding="8,4" Click="New_Click"/>
                <Button Content="Открыть" Margin="8,0" Padding="8,4" Click="Open_Click"/>
                <Button Content="Удалить" Padding="8,4" Click="Delete_Click"/>
            </WrapPanel>
        </StackPanel>
        <DataGrid x:Name="Grid" ItemsSource="{Binding Invoices}" IsReadOnly="True"
            SelectionMode="Single" AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="100"/>
                <DataGridTextColumn Header="Номер" Binding="{Binding Number}" Width="*"/>
                <DataGridTextColumn Header="Поставщик" Binding="{Binding Supplier}" Width="2*"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="100"/>
                <DataGridTextColumn Header="Сумма, ₽" Binding="{Binding InvoiceTotal, StringFormat=N2}" Width="105"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Page>
